# Sao chép file này thành .env.local rồi điền giá trị từ Supabase Studio
# (Project Settings › API). KHÔNG commit .env.local.

# URL project Supabase, ví dụ https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Khóa anon (public) — an toàn để lộ ra client, RLS bảo vệ dữ liệu
NEXT_PUBLIC_SUPABASE_ANON_KEY=
